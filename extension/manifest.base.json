{
  "manifest_version": 3,
  "name": "Declutter",
  "description": "Hides YouTube Shorts and refuses cookie banners. Czech sites first.",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Declutter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "description": "Open Declutter"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "shorts/shorts.js"
      ],
      "css": [
        "shorts/shorts.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "consent/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.mapy.com/*",
        "*://*.mapy.cz/*",
        "*://*.kupi.cz/*",
        "*://cmp.seznam.cz/*",
        "*://myprivacy.dpgmedia.nl/*",
        "*://myprivacy.dpgmedia.be/*"
      ],
      "js": [
        "consent/open-shadow.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "shorts",
        "enabled": true,
        "path": "shorts/dnr-rules.json"
      }
    ]
  }
}
