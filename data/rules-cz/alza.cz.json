{
  "name": "cz-alza",
  "runContext": {
    "urlPattern": "^https?://([a-z0-9-]+\\.)*alza\\.cz/"
  },
  "detectCmp": [
    {
      "any": [
        {
          "exists": ".js-cookies-info .js-cookies-info-reject"
        },
        {
          "exists": ".js-cookie-reject-all"
        }
      ]
    }
  ],
  "detectPopup": [
    {
      "visible": ".js-cookies-info .js-cookies-info-reject, .js-cookie-reject-all",
      "check": "any"
    }
  ],
  "optIn": [
    {
      "if": {
        "exists": ".js-cookie-accept-all"
      },
      "then": [
        {
          "waitForThenClick": ".js-cookie-accept-all"
        }
      ],
      "else": [
        {
          "waitForThenClick": ".js-cookies-info .js-cookies-info-accept"
        }
      ]
    }
  ],
  "optOut": [
    {
      "if": {
        "exists": ".js-cookie-reject-all"
      },
      "then": [
        {
          "waitForThenClick": ".js-cookie-reject-all",
          "retry": 2
        }
      ],
      "else": [
        {
          "eval": "DECLUTTER_ALZA_REJECT"
        }
      ]
    },
    {
      "waitForVisible": ".js-cookies-info .js-cookies-info-reject, .js-cookie-reject-all",
      "check": "none",
      "timeout": 5000
    }
  ],
  "test": [
    {
      "waitForVisible": ".js-cookies-info",
      "check": "none",
      "timeout": 3000
    }
  ],
  "_comment": "Desktop www.alza.cz (reject link is a CSP-blocked javascript: URL -> snippet) and mobile m.alza.cz (plain link)."
}
