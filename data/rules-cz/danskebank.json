{
  "name": "danskebank",
  "_comment": "OK til nødvendige = necessary only. (Consent-O-Matic had a rule; autoconsent did not handle it.)",
  "runContext": {
    "urlPattern": "^https?://([a-z0-9-]+\\.)*(danskebank\\.dk|danskebank\\.se|danskebank\\.no|danskebank\\.fi|danskebank\\.com)/"
  },
  "detectCmp": [
    {
      "exists": "#button-accept-necessary"
    }
  ],
  "detectPopup": [
    {
      "visible": "#button-accept-necessary"
    }
  ],
  "optIn": [
    {
      "waitForThenClick": "#button-accept-all"
    }
  ],
  "optOut": [
    {
      "waitForThenClick": "#button-accept-necessary",
      "retry": 2
    },
    {
      "waitForVisible": "#button-accept-necessary",
      "check": "none",
      "timeout": 5000
    }
  ]
}
