{
  "name": "cz-pilulka",
  "runContext": {
    "urlPattern": "^https?://([a-z0-9-]+\\.)*pilulka\\.cz/"
  },
  "detectCmp": [
    {
      "exists": ".cookiebar .cookiebar__reject"
    }
  ],
  "detectPopup": [
    {
      "visible": ".cookiebar .cookiebar__reject"
    }
  ],
  "optIn": [
    {
      "waitForThenClick": ".cookiebar [data-cy=accept-cookies]"
    }
  ],
  "optOut": [
    {
      "waitForThenClick": ".cookiebar .cookiebar__reject",
      "retry": 4,
      "retryInterval": 1000
    },
    {
      "waitForVisible": ".cookiebar .cookiebar__reject",
      "check": "none",
      "timeout": 5000
    }
  ],
  "test": [
    {
      "waitForVisible": ".cookiebar .cookiebar__reject",
      "check": "none",
      "timeout": 3000
    }
  ],
  "_comment": "2026-11-11: the bar is now <section class=cookiebar> with \"ODMÍTNOUT\" in capitals; matched by its classes instead of the text. A click before the page hydrates does nothing, so the refuse click is retried while the bar stays."
}
