{
  "name": "declutter",
  "version": "1.2.2",
  "description": "Hides YouTube Shorts and answers cookie banners the way you choose (Chrome, Safari, Firefox)",
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --test test/*.test.mjs",
    "test:e2e": "node build.mjs chrome && node test/e2e.mjs",
    "canary": "node canary/run.mjs --build",
    "safari": "scripts/safari.sh",
    "test:walls": "node build.mjs chrome && node test/walls.mjs",
    "ios": "scripts/ios.sh",
    "test:mobile": "node build.mjs chrome && node test/mobile.mjs",
    "test:features": "node build.mjs chrome && node test/features.mjs",
    "test:categories": "node build.mjs chrome && node test/categories.mjs",
    "test:posts": "node build.mjs chrome && node test/posts.mjs",
    "test:playables": "node build.mjs chrome && node test/playables.mjs",
    "test:dates": "node build.mjs chrome && node test/dates.mjs",
    "test:states": "node build.mjs chrome && node test/states.mjs",
    "store": "node build.mjs --store && node store/screenshots.mjs"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "^18.3.0"
  },
  "private": true
}
