<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily canary on this Mac. Install/remove with scripts/canary-agent.sh install|remove. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.theanhgen.declutter-canary</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-lc</string>
		<string>cd "__REPO__" &amp;&amp; node build.mjs chrome &amp;&amp; node canary/run.mjs</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/tmp/declutter-canary.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/declutter-canary.log</string>
</dict>
</plist>
